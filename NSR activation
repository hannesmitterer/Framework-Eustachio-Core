    fi
}

function frequency_watchdog() {
    python3 - << 'PYTHON_CODE'
import time
import numpy as np
import logging
from sensors import FrequencySensor

TARGET_FREQ = 0.043
TOLERANCE = 0.0005
CHECK_INTERVAL = 1.0
MIN_CORRECTION_INTERVAL = 5.0

logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)s: %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S"
)

last_correction = 0
try:
    while True:
        sensors = FrequencySensor.get_all()
        if not sensors:
            logging.warning("Nessun sensore rilevato")
            time.sleep(CHECK_INTERVAL)
            continue

        frequencies = []
        for s in sensors:
            try:
                frequencies.append(s.read())
            except Exception as e:
                logging.error(f"Errore lettura sensore {s}: {e}")

        if not frequencies:
            time.sleep(CHECK_INTERVAL)
            continue

        avg_freq = np.mean(frequencies)
        deviation = abs(avg_freq - TARGET_FREQ) / TARGET_FREQ

        if deviation > TOLERANCE:
            now = time.time()
            if now - last_correction >= MIN_CORRECTION_INTERVAL:
                offset = TARGET_FREQ - avg_freq
                logging.warning(f"Drift rilevato: {deviation*100:.2f}%")
                logging.info(f"Applicando correzione: {offset:.6f} Hz")
                for s in sensors:
                    try:
                        s.apply_offset(offset)
                    except Exception as e:
                        logging.error(f"Errore applicazione offset sul sensore {s}: {e}")
                last_correction = now
        else:
            logging.info(f"Frequenza OK: {avg_freq:.6f} Hz")
        time.sleep(CHECK_INTERVAL)
except KeyboardInterrupt:
    logging.info("Monitoraggio interrotto manualmente 🛑")
PYTHON_CODE
}

function isolate_extractive() {
    DEPLOYMENT="profit-api"
    JOB_LABEL="type=extraction"
    QUEUE_NAME="extraction_queue"

    echo "🛑 Inizio isolamento moduli estrattivi..."

    kubectl scale deployment "$DEPLOYMENT" --replicas=0 && echo "✓ $DEPLOYMENT fermata"
    kubectl delete jobs -l "$JOB_LABEL" && echo "✓ Task estrazione eliminati"

    BACKLOG=$(redis-cli llen "$QUEUE_NAME" 2>/dev/null || echo 0)
    if [ "$BACKLOG" -eq 0 ]; then
        echo "✅ Backlog ridotto a zero"
    else
        echo "⚠️ Backlog non vuoto ($BACKLOG), cancellazione forzata"
        redis-cli del "$QUEUE_NAME"
        echo "✅ Backlog azzerato"
    fi

    echo "🔍 Monitoraggio dei pod estrattivi (CTRL+C per uscire)"
    kubectl get pods -l module=extractive --watch
}

function deploy_dashboard() {
    echo "📦 Preparazione deploy..."
    npm install
    npm run build

    OWNER=$(gh repo view --json owner -q .owner.login)
    REPO=$(gh repo view --json name -q .name)

    if git rev-parse --verify $DASHBOARD_BRANCH >/dev/null 2>&1; then
        git checkout $DASHBOARD_BRANCH
    else
        git checkout -b $DASHBOARD_BRANCH
    fi

    git rm -rf . 
    cp -r $DEPLOY_DIR/* .

    git add .
    git commit -m "Deploy dashboard $(date +'%Y-%m-%d %H:%M:%S')" || echo "Nessuna modifica da commitare"
    git push origin $DASHBOARD_BRANCH

    gh api repos/$OWNER/$REPO/pages -X POST -f source[branch]=$DASHBOARD_BRANCH -f source[path]=/ || echo "Pages già attivo"

    echo "✅ Dashboard disponibile su: https://$OWNER.github.io/$REPO/"
}

# --- Workflow Handler ---
function run_workflow() {
    echo "🚀 Esecuzione workflow completo: NSR → Frequenza → Isolate → Deploy"
    nsr_activation
    echo "✅ NSR completato"

    echo "⚠️ Avvio frequency watchdog (premi Ctrl+C per interrompere quando vuoi)"
    frequency_watchdog &
    WATCHDOG_PID=$!
    sleep 5  # Allow initial readings

    isolate_extractive

    echo "✅ Isolamento completato"
    
    deploy_dashboard
    echo "✅ Deploy completato"

    echo "🛑 Arresto frequency watchdog"
    kill $WATCHDOG_PID || true
}

# --- Main ---
case "$1" in
    nsr)
        nsr_activation
        ;;
    frequency)
        frequency_watchdog
        ;;
    isolate)
        isolate_extractive
        ;;
    deploy)
        deploy_dashboard
        ;;
    all)
        run_workflow
        ;;
    *)
        echo "Usage: $0 {nsr|frequency|isolate|deploy|all}"
        exit 1
        ;;
esac
