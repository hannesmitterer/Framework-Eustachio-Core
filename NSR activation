#!/usr/bin/env python3
# frequency-watchdog.py
# Monitoraggio e correzione automatica 0.043 Hz

import time
import numpy as np
import logging
from sensors import FrequencySensor

# --- Configuration ---
TARGET_FREQ = 0.043        # Hz
TOLERANCE = 0.0005         # 0.5%
CHECK_INTERVAL = 1.0       # seconds
MIN_CORRECTION_INTERVAL = 5.0  # minimum seconds between corrections

# --- Logging Setup ---
logging.basicConfig(
    level=logging.INFO,
    format="%(asctime)s %(levelname)s: %(message)s",
    datefmt="%Y-%m-%d %H:%M:%S"
)

def monitor_frequency():
    last_correction = 0
    while True:
        try:
            sensors = FrequencySensor.get_all()
            if not sensors:
                logging.warning("Nessun sensore rilevato")
                time.sleep(CHECK_INTERVAL)
                continue

            frequencies = []
            for s in sensors:
                try:
                    freq = s.read()
                    frequencies.append(freq)
                except Exception as e:
                    logging.error(f"Errore lettura sensore {s}: {e}")

            if not frequencies:
                logging.warning("Nessuna lettura valida disponibile")
                time.sleep(CHECK_INTERVAL)
                continue

            avg_freq = np.mean(frequencies)
            deviation = abs(avg_freq - TARGET_FREQ) / TARGET_FREQ

            if deviation > TOLERANCE:
                now = time.time()
                if now - last_correction >= MIN_CORRECTION_INTERVAL:
                    offset = TARGET_FREQ - avg_freq
                    logging.warning(f"Drift rilevato: {deviation*100:.2f}%")
                    logging.info(f"Applicando correzione: {offset:.6f} Hz")
                    for s in sensors:
                        try:
                            s.apply_offset(offset)
                        except Exception as e:
                            logging.error(f"Errore applicazione offset sul sensore {s}: {e}")
                    last_correction = now
                    logging.info("Ricalibrazione completata ✅")
                else:
                    logging.info("Drift rilevato ma correzione rimandata per rispetto intervallo minimo")
            else:
                logging.info(f"Frequenza OK: {avg_freq:.6f} Hz ✓")

        except Exception as e:
            logging.error(f"Errore inatteso nel monitoraggio: {e}")

        time.sleep(CHECK_INTERVAL)

if __name__ == "__main__":
    try:
        monitor_frequency()
    except KeyboardInterrupt:
        logging.info("Monitoraggio interrotto manualmente 🛑")
✅ Improvements in this version
Logging instead of print with timestamps for better tracking in long runs.

Error handling for sensor read failures and offset application.

Minimum interval between corrections (MIN_CORRECTION_INTERVAL) to avoid over-correcting.

Dynamic sensor detection inside the loop, so newly added sensors are automatically monitored.

Graceful shutdown via KeyboardInterrupt.

Warnings when no sensors are detected or readings fail.

